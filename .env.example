# Copy this file to .env and fill in values for local development.
# NEVER commit the real .env file.

# --- PostgreSQL (shared by question-service and quiz-service) ---
DB_URL=jdbc:postgresql://localhost:5432/questiondb
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- Spring AI: Ollama (local, free) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Optional: swap to a hosted provider via Spring AI profiles ---
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small